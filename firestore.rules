rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can read and write only their own data under users/{their uid}.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // LINE linking codes. The app creates a short-lived 6-digit code for the signed-in user;
    // the LINE worker (service account, not bound by these rules) reads and deletes it.
    match /lineLinks/{code} {
      allow create: if request.auth != null
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'lang', 'expires'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lang in ['th', 'en']
        && request.resource.data.expires is int;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Written by the LINE worker when a user links. The user can see it, change the
    // message language, or delete it to disconnect.
    match /lineUsers/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lang'])
        && request.resource.data.lang in ['th', 'en'];
    }

    // Everything else is closed.
  }
}
